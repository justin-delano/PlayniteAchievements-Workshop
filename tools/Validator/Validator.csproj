<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Workshop.Validator</RootNamespace>
    <AssemblyName>workshop-validator</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- XamlTemplateSanitizer.cs is a byte-identical copy of the extension's net462 file, which
         has no nullable annotations; the drift workflow keeps it that way. -->
    <NoWarn>$(NoWarn);nullable</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Byte-identical copy of the extension's WorkshopPackageFields.json; the drift workflow keeps it that way. -->
    <EmbeddedResource Include="package-fields.json" LogicalName="package-fields.json" />
  </ItemGroup>

</Project>
